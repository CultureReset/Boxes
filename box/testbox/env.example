# Point the daemon at what is running next door. Copy to .env or export these
# before `npm start` in daemon/.

NODEOS_PORT=7770

# Ollama, OpenAI-compatible. The /v1 matters.
NODEOS_LLM_URL=http://127.0.0.1:11434/v1
NODEOS_LLM_MODEL=qwen2.5:3b

# The voice. A binary on disk, no server. Sentence on stdin, WAV at {out}.
# This is what the shipped box uses; Piper is the fallback under it.
# NODEOS_TTS_CMD=kokoro-onnx --voice af_sky --out {out}

# Only if you are running an engine that ships as a container. Last resort,
# under both of the above. Leave it commented out and nothing is over HTTP.
# NODEOS_TTS_URL=http://127.0.0.1:8880/v1

# The platform. Without these the daemon answers from local data only.
# NODEOS_API_URL=https://...
# NODEOS_API_TOKEN=...
# NODEOS_SLUG=...
