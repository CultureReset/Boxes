{
  "name": "NODE",
  "short_name": "NODE",
  "description": "Your computer, on your phone — local hub and remote control.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0d13",
