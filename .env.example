# NODE portable install — copy to .env and edit. Current ports are the live defaults.
# Paths are derived from the account that runs NODE; never put a literal /home/<user> here.

HOME=${HOME}
NODE_DATA=${HOME}/.local/share/nodeos
NODE_HOST=127.0.0.1

# Core listen ports (change these so a second copy does not collide with a running NODE)
NODEOS_PORT=7770
DOOR_PORT=7700
NODE_HOME_PORT=7690
HUB_PORT=7790

# Public URLs: leave unset to auto-detect Tailscale MagicDNS, or set explicitly.
# NODEOS_DETECT_TAILSCALE=1
# NODEOS_TAILNET_HOSTNAME=
# NODEOS_TAILSCALE_IP=
# NODE_PUBLIC_DOMAIN=voicecommandapi.com
# NODE_PUBLIC_SCHEME=https
# NODEOS_DOOR_PUBLIC=
# NODEOS_PUBLIC_ORIGIN=
# NODEOS_FRAME_HOST=
# NODEOS_FRAME_ANCESTORS=
# NODEOS_DOOR_PUBLIC_PORT=10000
# NODEOS_SERVE_PORT=14443

# Local-only install / tests: do not start per-app frame proxies, do not probe Tailscale,
# and let the shell render without a door session.
# NODEOS_START_FRAMES=0
# NODEOS_DETECT_TAILSCALE=0
# NODEOS_DEV_OPEN=1

# Optional overrides
# NODEOS_CONFIG_DIR=
# NODEOS_FRAMES=
# NODEOS_WEBAPPS_FILE=
# NODEOS_CONTROL_FILE=
# NODEOS_UPLOAD_DIR=${NODE_DATA}/uploads
# NODEOS_SHELL_DIST=
# NODEOS_APP_TOKEN_FILE=${HOME}/.config/nodeos/app-token
# HUB_TOKEN_FILE=${HOME}/.config/mcp-hub/token
# HUB_ALLOW_EPHEMERAL_TOKEN=0
# HUB_REGISTRY=
# APPROVAL_APP_ROOT=
# VITE_DEV_PORT=5173
