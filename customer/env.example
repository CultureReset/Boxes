# Names only, with placeholders. scripts/provision-customer.sh writes the real file
# to customers/<slug>/compose.env (mode 0600, git-ignored). Do not put secrets here:
# tokens and passwords live in customers/<slug>/secrets/ and are mounted as files.
#
# Every value below that used to be the platform owner's is REQUIRED. The daemon
# refuses to start in customer mode without them, and refuses the platform owner's
# own Paperclip company and lead ids.

# ---- identity --------------------------------------------------------------
CUSTOMER_SLUG=replace-with-slug              # lowercase letters, digits, dashes
NODEOS_SLUG=replace-with-slug                # the business slug at gcr-api-clean
NODEOS_OWNER_NAME=replace-with-owner-name    # who Lead's issues are "From"; replaces the hard-coded owner name
NODEOS_BUSINESS_NAME=replace-with-business-name

# ---- this customer's Paperclip company (one per customer, created by the platform owner) ----
PAPERCLIP_API_URL=http://replace-host:3100/api
PAPERCLIP_COMPANY_ID=00000000-0000-0000-0000-000000000000
PAPERCLIP_LEAD_ID=00000000-0000-0000-0000-000000000000

# ---- platform API (gcr-api-clean). The business token is a SECRET: customers/<slug>/secrets/api_token ----
NODEOS_API_URL=https://replace-platform-api.example

# ---- what the container may reach (comma-separated host names / IPv4, nothing else) ----
EDGE_ALLOW=replace-paperclip-host,replace-platform-api.example

# ---- network and ports (the provision script picks unused ones) ----
EDGE_SUBNET=10.77.1.0/24
WEB_SUBNET=10.78.1.0/24
NODE_HOST_PORT=18001                         # published on 127.0.0.1 only
DESKTOP_HOST_PORT=19001                      # published on 127.0.0.1 only; profile desktop

# ---- where the secret files live (absolute path) ----
SECRETS_DIR=/absolute/path/to/customers/replace-with-slug/secrets

# ---- images (built from this repository by default) ----
# NODE_IMAGE=nodeos-customer:local
# EDGE_IMAGE=nodeos-customer-edge:local
# DESKTOP_IMAGE=nodeos-customer-desktop:local

# ---- limits (defaults shown) ----
# NODE_CPUS=1.0
# NODE_MEMORY=768m
# NODE_PIDS=256
# DESKTOP_CPUS=2.0
# DESKTOP_MEMORY=2g
# DESKTOP_PIDS=512
